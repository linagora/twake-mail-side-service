{
  "name": "twake-mail-side-service",
  "version": "0.1.0",
  "private": true,
  "description": "Gives each TwakeSpace space a TMail team mailbox and keeps its members in step with the space",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "^0.6.0",
    "drizzle-orm": "^0.45.3",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^11.0.0",
    "@testcontainers/rabbitmq": "^11.0.0",
    "@types/node": "^20.19.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.0"
  }
}
