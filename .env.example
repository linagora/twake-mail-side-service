RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=twake-mail-side-service
RABBITMQ_SPACE_EXCHANGE=space
RABBITMQ_DNS_EXCHANGE=admin-panel
RABBITMQ_DNS_ROUTING_KEY=dns.validated
RABBITMQ_USER_DELETED_EXCHANGE=b2b
RABBITMQ_USER_DELETED_ROUTING_KEY=domain.user.deleted
RABBITMQ_ACTIVITY_EXCHANGE=activity
RABBITMQ_PREFETCH=1

DATABASE_URL=postgres://twake_mail:change-me@localhost:5432/twake_mail

TMAIL_WEBADMIN_URL=http://localhost:8000
TMAIL_WEBADMIN_PASSWORD=

LOG_LEVEL=info
HEALTH_PORT=8080
SHUTDOWN_TIMEOUT_MS=10000
